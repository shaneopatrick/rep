#!/usr/bin/env python3
"""rep: one-screen briefs for work you own and agents do.

Inside Claude Code you type /shape, /approve and /review. This CLI is the
same harness from a terminal, plus the commands the agent uses.

The agent's commands:
  rep brief draft < text    save a draft brief (or a revision) for you to /approve
  rep check                 run the brief's check; the harness records the result
  rep note "<text>"         add a line to the brief's log
  rep diff                  the brief's whole change, new files included
  rep simplify start|done   the shrink-only simplify pass, at the start of /review
  rep mistake <pattern> "<what>"   add to the mistakes register

Yours, in a terminal:
  rep init                  turn rep on for this repo
  rep approve [pre-mortem]  same as /approve
  rep review [accept|redirect|reject] [note]   same as /review
  rep pin <paths> | rep unpin [paths]          pinned tests are read-only for the agent
  rep skip                  release this brief's TODO(human) regions

Both:
  rep brief                 show the active brief (or the draft)
  rep status                brief, budget, check, pins
  rep report                what your briefs add up to
  rep log                   recent closed briefs
  rep mistakes              the mistakes register, grouped by pattern
  rep restore <file>        put back a protected file changed through Bash
  rep doctor                check the install
"""
import argparse
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "hooks"))
import replib  # noqa: E402

HOOKS = ("on_prompt", "session_start", "budget_gate", "lock_tests", "guard_human", "bash_guard", "bash_audit",
         "done_gate")
SKILLS = ("shape", "approve", "review", "pin", "hint", "skip")
TAIL = 60          # lines of check output shown; the agent pays for every line it reads
SLOW = 60          # seconds; a slower check makes a poor inner loop


def need_root():
    root = replib.find_root(os.getcwd())
    if not root:
        sys.exit("rep is not enabled here. Run `rep init` at the repo root, or type /shape in Claude Code.")
    return root


def cmd_init(args):
    root, notes = replib.init_root(os.getcwd())
    print("\n".join(notes))
    print("Start a piece of work with /shape <goal> inside Claude Code.")


def cmd_brief(args):
    root = need_root()
    if args.action == "draft":
        text = sys.stdin.read()
        with replib.state_tx(root) as state:
            message, ok = replib.draft(root, state, text)
        print(message)
        sys.exit(0 if ok else 1)
    state = replib.load_state(root)
    relpath = state["active"] or state["draft"]
    if not relpath:
        sys.exit("no brief. /shape <goal> starts one.")
    if args.action == "path":
        print(replib.rep_path(root, relpath))
        return
    if state["draft"] and state["active"]:
        print("(a revision draft is waiting for /approve; `rep brief path` prints the active one)\n")
    print(replib.read_text(replib.rep_path(root, state["draft"] or relpath)).rstrip())


def cmd_note(args):
    root = need_root()
    with replib.state_tx(root) as state:
        if not state["active"]:
            sys.exit("rep: no active brief to note on.")
        replib.append_log(root, state, " ".join(args.text))
    print("[rep] noted.")


def cmd_check(args):
    root = need_root()
    state = replib.load_state(root)
    relpath = state["active"] or state["draft"]
    if not relpath:
        sys.exit("rep: no brief, so no check. /shape <goal> starts one.")
    cmd = replib.check_cmd(replib.load_brief(root, relpath))
    started = time.time()
    proc = subprocess.run(cmd, shell=True, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    secs = time.time() - started
    output = proc.stdout.decode("utf-8", "replace").rstrip().splitlines()
    if len(output) > TAIL:
        print("… %d earlier lines omitted" % (len(output) - TAIL))
    print("\n".join(output[-TAIL:]))

    ok = proc.returncode == 0
    tree = replib.snapshot(root)
    with replib.state_tx(root) as state:
        flaky = replib.record_run(root, state, ok, secs, tree, proc.returncode)
        f = replib.facts(root, state) if state["active"] else None
    summary = "rep check: %s (exit %d) in %.1fs" % ("PASS" if ok else "FAIL", proc.returncode, secs)
    if f:
        summary += " · " + replib.usage(f)
    print("\n" + summary)
    if flaky:
        print("rep: FLAKY. The same code gave a different result earlier. Treat it as a bug in the check: find the "
              "randomness (time, ordering, network, shared state) before trusting either result.")
    if secs > SLOW:
        print("rep: slow check (%.0fs). Find a narrower command for the inner loop and keep this one for the end." % secs)
    sys.exit(proc.returncode)


def cmd_diff(args):
    root = need_root()
    state = replib.load_state(root)
    if not state["active"]:
        sys.exit("rep: no active brief.")
    sys.stdout.write(replib.brief_diff(root, state))


def cmd_simplify(args):
    root = need_root()
    with replib.state_tx(root) as state:
        message, ok = (replib.simplify_start if args.action == "start" else replib.simplify_done)(root, state)
    print(message)
    sys.exit(0 if ok else 1)


def cmd_mistake(args):
    root = need_root()
    if args.pattern not in dict(replib.PATTERNS):
        sys.exit("rep: unknown pattern %r. Use one of:\n%s" % (args.pattern, "\n".join(
            "  %-22s %s" % p for p in replib.PATTERNS)))
    source = "reviewer" if os.environ.get("CLAUDECODE") else "user"
    with replib.state_tx(root) as state:
        already = dict((p, n) for p, n, _ in replib.mistakes_by_pattern(root, replib.brief_id(state))).get(args.pattern)
        replib.record_mistake(root, state, args.pattern, source, " ".join(args.note))
    print("[rep] recorded: %s." % args.pattern)
    if already and replib.brief_id(replib.load_state(root)):
        print("rep: this brief already had %d %s entr%s. If that was the same defect, it is now counted twice; "
              "the register is append-only, so say so in your reply." % (already, args.pattern,
                                                                         "y" if already == 1 else "ies"))


def cmd_mistakes(args):
    root = need_root()
    grouped = replib.mistakes_by_pattern(root)
    if not grouped:
        print("no mistakes recorded yet")
    meaning = dict(replib.PATTERNS)
    for pattern, count, notes in grouped:
        print("%-22s x%-3d %s" % (pattern, count, meaning[pattern]))
        for note in notes:
            print("%28s %s" % ("-", replib._clip(note, 90)))


def cmd_approve(args):
    root = need_root()
    with replib.state_tx(root) as state:
        print(replib.approve(root, state, " ".join(args.premortem)))


def cmd_review(args):
    root = need_root()
    with replib.state_tx(root) as state:
        print(replib.review(root, state, " ".join(args.words)))


def cmd_pin(args):
    root = need_root()
    with replib.state_tx(root) as state:
        print(replib.pin(root, state, args.paths, os.getcwd()))


def cmd_unpin(args):
    root = need_root()
    with replib.state_tx(root) as state:
        print(replib.unpin(root, state, [replib.rel(root, p) if os.path.exists(p) else p for p in args.paths]))


def cmd_skip(args):
    root = need_root()
    with replib.state_tx(root) as state:
        print(replib.skip(root, state))


def cmd_status(args):
    root = need_root()
    state = replib.load_state(root)
    if args.json:
        print(json.dumps(state, indent=2, sort_keys=True))
        return
    print("rep: %s" % root)
    if state["active"]:
        f = replib.facts(root, state)
        print("brief: %s  (%s)" % (f["title"], replib.rep_path(root, state["active"])))
        print("  %s · %s · check `%s`" % (replib.usage(f), f["check"], f["cmd"]))
        print("  breaker trips %d · refused edits %d · flaky runs %d" % (state["trips"], state["refused"], state["flakes"]))
    if state["draft"]:
        print("draft waiting for /approve: %s" % replib.rep_path(root, state["draft"]))
    if not state["active"] and not state["draft"]:
        print("no brief: ordinary Claude Code. /shape <goal> starts one.")
    if state["region_files"]:
        print("TODO(human): %s, hints %d/%d%s" % (", ".join(state["region_files"]), state["hints"],
                                                  len(replib.HINTS), ", released" if state["todo_released"] else ""))
    if state["pins"]:
        print("pinned: %s" % ", ".join(sorted(state["pins"])))


def cmd_log(args):
    root = need_root()
    rows = [r for r in replib.read_jsonl(root, "reps.jsonl") if r.get("kind") == "brief"][-args.tail:]
    if not rows:
        print("no closed briefs yet")
    for r in rows:
        actual, budget = r.get("actual") or {}, r.get("budget") or {}
        print("%-10s %-9s %4s/%-4s lines  check %-7s %s" % (
            (r.get("createdAt") or "")[:10], r.get("outcome", ""), actual.get("lines", "?"), budget.get("lines", "?"),
            "passing" if (r.get("check") or {}).get("passingAtClose") else "-", replib._clip(r.get("title"), 60)))


def cmd_report(args):
    root = need_root()
    briefs = [r for r in replib.read_jsonl(root, "reps.jsonl") if r.get("kind") == "brief"]
    events = replib.read_jsonl(root, "events.jsonl")
    print("rep report: %s" % root)
    if not briefs:
        print("no closed briefs yet")
        return
    count = lambda rows, test: sum(1 for r in rows if test(r))  # noqa: E731
    print("briefs     %d closed: %d accepted, %d rejected" % (
        len(briefs), count(briefs, lambda r: r["outcome"] == "accepted"), count(briefs, lambda r: r["outcome"] == "rejected")))
    ratios = sorted(r["actual"]["lines"] / float(r["budget"]["lines"]) for r in briefs
                    if (r.get("actual") or {}).get("lines") is not None and r["budget"].get("lines"))
    if ratios:
        print("budget     actual/estimated lines: median %.2f (range %.2f to %.2f); closed over budget: %d; "
              "breaker trips: %d" % (ratios[len(ratios) // 2], ratios[0], ratios[-1],
                                     count(ratios, lambda x: x > 1), sum(r.get("trips", 0) for r in briefs)))
    checks = [r.get("check") or {} for r in briefs]
    print("check      red before green: %d/%d; passing on the final code at close: %d/%d; flaky runs: %d" % (
        count(checks, lambda c: c.get("redFirst")), len(checks), count(checks, lambda c: c.get("passingAtClose")),
        len(checks), sum(c.get("flakes", 0) for c in checks)))
    print("scope      edits refused for scope or dependencies: %d" % sum(r.get("refused", 0) for r in briefs))
    passes = [r["simplify"] for r in briefs if r.get("simplify")]
    if passes:
        cuts = sorted((p["before"] - p["after"]) / float(p["before"]) for p in passes if p["before"])
        print("simplify   %d pass(es); median cut %d%% of the diff" % (len(passes), round(cuts[len(cuts) // 2] * 100)))
    grouped = replib.mistakes_by_pattern(root)
    if grouped:
        print("mistakes   %s (rep mistakes for detail)" % ", ".join("%s x%d" % (p, n) for p, n, _ in grouped[:4]))
    print("premortem  written for %d of %d briefs" % (
        count(briefs, lambda r: r.get("premortem") not in (None, "", "(none)")), len(briefs)))
    print("bypasses   %d protected-file change(s) through Bash (0 is the goal)" % sum(
        len(e.get("files", [])) for e in events if e.get("event") == "violation"))


def cmd_restore(args):
    root = need_root()
    file = args.file
    if os.path.exists(file) or os.path.isabs(file):
        file = replib.rel(root, file)
    keep = replib.keep_path(root, file)
    if not os.path.exists(keep):
        sys.exit("rep: no kept pre-image for %s" % file)
    replib.write_text(os.path.join(root, file), replib.read_text(keep))
    replib.event(root, "restore", file=file)
    print("[rep] %s restored to its state before the Bash command." % file)


def cmd_doctor(args):
    home = os.path.expanduser("~/.claude")
    ok = True

    def check(label, good, fix=""):
        nonlocal ok
        ok = ok and good
        print("%s %s%s" % ("ok  " if good else "FAIL", label, "" if good or not fix else "  -> " + fix))

    check("python %d.%d" % sys.version_info[:2], sys.version_info >= (3, 8), "needs 3.8+")
    for name in HOOKS + ("replib",):
        check("hook  %s.py" % name, os.path.exists(os.path.join(home, "hooks", name + ".py")), "run install.py")
    for name in SKILLS:
        check("skill /%s" % name, os.path.exists(os.path.join(home, "skills", name, "SKILL.md")), "run install.py")
    check("style %s" % replib.STYLE, os.path.exists(os.path.join(home, "output-styles", replib.STYLE + ".md")),
          "run install.py")
    try:
        with open(os.path.join(home, "settings.json")) as f:
            registered = json.dumps(json.load(f).get("hooks", {}))
    except (OSError, ValueError):
        registered = ""
    for name in HOOKS:
        check("settings.json runs %s.py" % name, "hooks/%s.py" % name in registered, "run install.py")
    check("settings.json no longer runs predict_gate.py", "predict_gate.py" not in registered, "run install.py")

    root = replib.find_root(os.getcwd())
    if not root:
        print("--   rep is not enabled in this directory (`rep init`, or /shape in Claude Code)")
    else:
        state = replib.load_state(root)
        print("--   enabled in %s, %s" % (root, "brief active" if state["active"] else "no active brief"))
        check(".rep/ is ignored by git", os.path.exists(replib.rep_path(root, ".gitignore")), "run any rep command")
    sys.exit(0 if ok else 1)


def main():
    parser = argparse.ArgumentParser(prog="rep", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command")
    sub.required = True

    p = sub.add_parser("init"); p.set_defaults(fn=cmd_init)
    p = sub.add_parser("brief"); p.add_argument("action", nargs="?", default="show", choices=("show", "draft", "path"))
    p.set_defaults(fn=cmd_brief)
    p = sub.add_parser("note"); p.add_argument("text", nargs="+"); p.set_defaults(fn=cmd_note)
    p = sub.add_parser("check"); p.set_defaults(fn=cmd_check)
    p = sub.add_parser("diff"); p.set_defaults(fn=cmd_diff)
    p = sub.add_parser("simplify"); p.add_argument("action", choices=("start", "done")); p.set_defaults(fn=cmd_simplify)
    p = sub.add_parser("mistake"); p.add_argument("pattern"); p.add_argument("note", nargs="*")
    p.set_defaults(fn=cmd_mistake)
    p = sub.add_parser("mistakes"); p.set_defaults(fn=cmd_mistakes)
    p = sub.add_parser("approve"); p.add_argument("premortem", nargs="*"); p.set_defaults(fn=cmd_approve)
    p = sub.add_parser("review"); p.add_argument("words", nargs="*"); p.set_defaults(fn=cmd_review)
    p = sub.add_parser("pin"); p.add_argument("paths", nargs="*"); p.set_defaults(fn=cmd_pin)
    p = sub.add_parser("unpin"); p.add_argument("paths", nargs="*"); p.set_defaults(fn=cmd_unpin)
    p = sub.add_parser("skip"); p.set_defaults(fn=cmd_skip)
    p = sub.add_parser("status"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_status)
    p = sub.add_parser("log"); p.add_argument("--tail", type=int, default=10); p.set_defaults(fn=cmd_log)
    p = sub.add_parser("report"); p.set_defaults(fn=cmd_report)
    p = sub.add_parser("restore"); p.add_argument("file"); p.set_defaults(fn=cmd_restore)
    p = sub.add_parser("doctor"); p.set_defaults(fn=cmd_doctor)

    args = parser.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
